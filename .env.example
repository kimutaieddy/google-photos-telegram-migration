# =====================================================================
# Google Photos to Telegram Migration System Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Telegram MTProto API Credentials (obtain from https://my.telegram.org)
# ---------------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Telethon StringSession (avoid interactive login on headless/Docker)
# Generate via: python scripts/generate_session.py
TELEGRAM_SESSION_STRING=

# Target Private Telegram Channel (Channel ID e.g. -1001234567890 or @channel_username)
TELEGRAM_CHANNEL_ID=-1001234567890

# Optional: Telegram Bot Token (for admin notifications or status alerts)
BOT_TOKEN=

# ---------------------------------------------------------------------
# Storage & Directory Constraints
# ---------------------------------------------------------------------
# Directory for database, temporary chunk downloads, and staging
DATA_DIR=data
TEMP_DIR=data/temp

# Minimum free disk space threshold in MegaBytes before pausing downloads
# Default: 1500 MB (1.5 GB safety buffer)
MIN_DISK_FREE_MB=1500

# ---------------------------------------------------------------------
# Rate Limiting & Safety Parameters
# ---------------------------------------------------------------------
# Delay in seconds between message uploads (avoids Telegram FLOOD_WAIT)
UPLOAD_DELAY_SECONDS=2.5

# Maximum retries per file on network failure
MAX_RETRIES=5

# Maximum file size allowed by Telegram in bytes (2 GB = 2147483648, Premium = 4294967296)
MAX_FILE_SIZE_BYTES=2147483648

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO

